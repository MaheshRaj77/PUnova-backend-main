# ═══════════════════════════════════════════════════════════════════════
# PUnova Backend - Environment Configuration (EXAMPLE ONLY)
# ═══════════════════════════════════════════════════════════════════════
# ⚠️  DO NOT commit real credentials to git
# ⚠️  Copy this file to .env and fill in actual values
# ═══════════════════════════════════════════════════════════════════════

# ── Server Configuration ─────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (PostgreSQL via Neon) ───────────────────────────────────
# Get from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# ── JWT Configuration ────────────────────────────────────────────────
# Use 32+ character random string (e.g., openssl rand -hex 32)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
JWT_EXPIRY=7d

# Refresh token secret (separate from JWT_SECRET)
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-characters
REFRESH_TOKEN_EXPIRY=30d

# ── Cloudinary (File Storage) ────────────────────────────────────────
# Get from: https://cloudinary.com/console
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET=your_cloudinary_api_secret

# ── Upstash Redis (Caching & Rate Limiting) ──────────────────────────
# Get from: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-upstash-request.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ── Firebase (Optional - for push notifications) ─────────────────────
# Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ── Email Configuration (Optional - for password reset) ───────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@punova.com

# ── CORS Configuration ───────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com,http://localhost:3000

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── API Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ── Admin Configuration ──────────────────────────────────────────────
# Default admin email and password (only for initial setup)
ADMIN_EMAIL=admin@punova.com
ADMIN_PASSWORD=change-me-in-production
